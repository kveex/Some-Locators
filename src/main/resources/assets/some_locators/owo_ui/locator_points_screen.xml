<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="vertical">
                    <children>
                        <label>
                            <text translate="true">ui.some_locators.locator_menu_label</text>
                            <margins>
                                <bottom>4</bottom>
                            </margins>
                        </label>

                        <flow-layout direction="vertical">
                            <children>
                                <scroll direction="vertical">
                                    <flow-layout direction="vertical" id="points_layout">
                                        <children/>
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                            <vertical method="content">0</vertical>
                                        </sizing>
                                    </flow-layout>
                                    <sizing>
                                        <vertical method="fill">100</vertical>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                    <padding>
                                        <all>12</all>
                                    </padding>
                                </scroll>
                            </children>

                            <surface>
                                <panel-with-inset>8</panel-with-inset>
                            </surface>
                            <sizing>
                                <horizontal method="fixed">298</horizontal>
                                <vertical method="fill">90</vertical>
                            </sizing>
                        </flow-layout>
                    </children>
                    <margins>
                        <all>8</all>
                    </margins>
                    <horizontal-alignment>center</horizontal-alignment>
                </flow-layout>
            </children>

            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </flow-layout>
    </components>
    <templates>
        <template name="template_point_info">
            <flow-layout direction="horizontal">
                <children>
                    <flow-layout direction="vertical">
                        <children>
                            <block state="{{state}}">
                                <sizing>
                                    <horizontal method="fixed">32</horizontal>
                                    <vertical method="fixed">32</vertical>
                                </sizing>
                            </block>
                        </children>
                        <margins>
                            <all>4</all>
                        </margins>
                        <padding>
                            <all>4</all>
                        </padding>
                        <surface>
                            <tooltip/>
                        </surface>
                        <tooltip-text translate="true">{{tooltip_text}}</tooltip-text>
                    </flow-layout>
                    <flow-layout direction="vertical">
                        <children>
                            <flow-layout direction="vertical">
                                <children>
                                    <label>
                                        <text>{{point_name}}</text>
                                        <margins>
                                            <all>8</all>
                                        </margins>
                                        <horizontal-text-alignment>center</horizontal-text-alignment>
                                        <vertical-text-alignment>center</vertical-text-alignment>
                                    </label>
                                </children>
                                <vertical-alignment>center</vertical-alignment>
                                <horizontal-alignment>center</horizontal-alignment>
                                <sizing>
                                    <horizontal method="fill">80</horizontal>
                                    <vertical method="content">0</vertical>
                                </sizing>
                            </flow-layout>
                            <flow-layout direction="horizontal">
                                <children>
                                    <button id="rename_point_button">
                                        <text translate="true">ui.some_locators.rename_point</text>
                                    </button>
                                    <button id="track_point_button">
                                        <text translate="true">ui.some_locators.track_point</text>
                                        <margins>
                                            <horizontal>4</horizontal>
                                        </margins>
                                    </button>
                                    <button id="remove_point_button">
                                        <text translate="true">ui.some_locators.remove_point</text>
                                    </button>
                                </children>
                                <horizontal-alignment>center</horizontal-alignment>
                                <vertical-alignment>center</vertical-alignment>
                            </flow-layout>
                        </children>
                        <vertical-alignment>center</vertical-alignment>
                        <horizontal-alignment>center</horizontal-alignment>
                    </flow-layout>
                </children>
                <padding>
                    <all>4</all>
                </padding>
                <surface>
                    <panel dark="true"/>
                </surface>
                <sizing>
                    <horizontal method="fill">100</horizontal>
                    <vertical method="content">0</vertical>
                </sizing>
                <vertical-alignment>center</vertical-alignment>
            </flow-layout>
        </template>
    </templates>
</owo-ui>