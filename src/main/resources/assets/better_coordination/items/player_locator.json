{
  "hand_animation_on_swap": false,
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "here",
        "model": {
          "type": "minecraft:model",
          "model": "better_coordination:item/locator_00"
        }
      },
      {
        "when": "close",
        "model": {
          "type": "minecraft:model",
          "model": "better_coordination:item/locator_16"
        }
      },
      {
        "when": "near",
        "model": {
          "type": "minecraft:model",
          "model": "better_coordination:item/locator_19"
        }
      },
      {
        "when": "far",
        "model": {
          "type": "minecraft:model",
          "model": "better_coordination:item/locator_30"
        }
      },
      {
        "when": "really_far",
        "model": {
          "type": "minecraft:model",
          "model": "better_coordination:item/locator_01"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/compass_00"
    }
  }
}