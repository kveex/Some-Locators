<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="horizontal">
            <children/>

            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </flow-layout>
    </components>
    <templates>
        <template name="point_settings_template">
            <flow-layout direction="horizontal">
                <children>
                    <flow-layout direction="vertical" id="block_layout">
                        <children>
                            <block state="{{state}}">
                                <sizing>
                                    <horizontal method="fixed">64</horizontal>
                                    <vertical method="fixed">64</vertical>
                                </sizing>
                            </block>
                        </children>

                        <horizontal-alignment>center</horizontal-alignment>
                        <vertical-alignment>center</vertical-alignment>

                        <padding>
                            <all>4</all>
                        </padding>

                        <surface>
                            <tooltip/>
                        </surface>
                    </flow-layout>

                    <flow-layout direction="vertical">
                        <children>
                            <flow-layout direction="vertical">
                                <children>
                                    <label>
                                        <text translate="true">ui.better_coordination.new_point_label</text>
                                    </label>
                                </children>
                                <padding>
                                    <left>2</left>
                                    <bottom>4</bottom>
                                </padding>
                            </flow-layout>

                            <flow-layout direction="vertical">
                                <children>
                                    <text-box id="name_text_box">
                                        <tooltip-text translate="true">ui.better_coordination.text_box_tooltip</tooltip-text>

                                        <sizing>
                                            <horizontal method="fixed">148</horizontal>
                                        </sizing>

                                        <cursor-style>text</cursor-style>
                                    </text-box>
                                </children>
                            </flow-layout>

                            <flow-layout direction="vertical">
                                <children>
                                    <button id="create_button">
                                        <text translate="true">{{button_text}}</text>
                                        <sizing>
                                            <horizontal method="fixed">150</horizontal>
                                        </sizing>
                                        <active>false</active>
                                    </button>
                                </children>
                            </flow-layout>
                        </children>

                        <padding>
                            <left>16</left>
                        </padding>

                        <horizontal-alignment>left</horizontal-alignment>
                    </flow-layout>
                </children>

                <horizontal-alignment>center</horizontal-alignment>
                <vertical-alignment>center</vertical-alignment>

                <padding>
                    <all>16</all>
                </padding>

                <surface>
                    <panel dark="true"/>
                </surface>
            </flow-layout>
        </template>
    </templates>
</owo-ui>